<?xml version="1.0" encoding="UTF-8"?>
<LightningMessageChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Bot → App actions (navigate, search, mutate)</description>
    <isExposed>true</isExposed>
    <lightningMessageFields>
        <description>canonical action (e.g., deactivate_staff)</description>
        <fieldName>action</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>target module (e.g., Human Resources)</description>
        <fieldName>module</fieldName>
    </lightningMessageFields>
    <lightningMessageFields>
        <description>person or record display name</description>
        <fieldName>name</fieldName>
    </lightningMessageFields>
    <masterLabel>BotActionMessageChannel</masterLabel>
</LightningMessageChannel>
