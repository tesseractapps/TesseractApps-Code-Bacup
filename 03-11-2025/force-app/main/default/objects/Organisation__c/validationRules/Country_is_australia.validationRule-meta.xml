<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Country_is_australia</fullName>
    <active>true</active>
    <description>Address(Country) should be Australia</description>
    <errorConditionFormula>NOT (ISPICKVAL( Address_Latest__CountryCode__s , &quot;AU&quot;))</errorConditionFormula>
    <errorDisplayField>Address_Latest__CountryCode__s</errorDisplayField>
    <errorMessage>Address(Country) should be Australia</errorMessage>
</ValidationRule>
