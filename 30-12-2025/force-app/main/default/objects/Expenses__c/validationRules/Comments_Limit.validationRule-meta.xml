<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Comments_Limit</fullName>
    <active>true</active>
    <errorConditionFormula>if(Len( Comments__c ) &gt;50,true,false)</errorConditionFormula>
    <errorDisplayField>Comments__c</errorDisplayField>
    <errorMessage>Max chars limit has been reached</errorMessage>
</ValidationRule>
