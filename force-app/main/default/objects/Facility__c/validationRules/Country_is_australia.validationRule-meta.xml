<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Country_is_australia</fullName>
    <active>false</active>
    <description>Country_is_australia</description>
    <errorConditionFormula>NOT (ISPICKVAL(Address__CountryCode__s , &quot;AU&quot;))</errorConditionFormula>
    <errorDisplayField>Address__CountryCode__s</errorDisplayField>
    <errorMessage>Address(Country) should be Australia</errorMessage>
</ValidationRule>
