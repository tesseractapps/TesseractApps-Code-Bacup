<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contact_No_Validation_Rule</fullName>
    <active>false</active>
    <description>Contact number value is 10 numbers not charcters</description>
    <errorConditionFormula>NOT(REGEX(Contact_No__c, &quot;\\D*?(\\d\\D*?){10}&quot;))</errorConditionFormula>
    <errorDisplayField>Contact_No__c</errorDisplayField>
    <errorMessage>Contact number value is 10 numbers not charcters</errorMessage>
</ValidationRule>
