<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ABN_validation_rule</fullName>
    <active>true</active>
    <description>ABN value is 11 numbers not charcters</description>
    <errorConditionFormula>AND(OR(ISBLANK(ABN__c),NOT(REGEX( ABN__c,&quot;[0-9]*&quot;)),LEN( ABN__c) != 11 ))</errorConditionFormula>
    <errorDisplayField>ABN__c</errorDisplayField>
    <errorMessage>ABN value should contain 11 numbers</errorMessage>
</ValidationRule>
