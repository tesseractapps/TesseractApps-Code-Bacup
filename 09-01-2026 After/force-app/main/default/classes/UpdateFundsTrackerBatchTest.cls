    @isTest
    static void testBatchExecution() {

        Test.startTest();
        UpdateFundsTrackerBatch batchObj = new UpdateFundsTrackerBatch();
        Database.executeBatch(batchObj, 50);
         // Schedule the job
        String cron = '0 0 0 1 1 ? 2099'; // Any future valid cron
        String jobId = System.schedule(
            'TestFundsTrackerSchedule',
            cron,
            new ScheduleFundsTrackerUpdate()
        );

        // Execute scheduled job
        CronTrigger ct = [SELECT Id FROM CronTrigger WHERE Id = :jobId];
        System.assertNotEquals(null, ct, 'Scheduler did not run');
        Test.stopTest();

        Date today = Date.today();
        Integer fyYear = today.year();
        if (today.month() < 7) {
            fyYear -= 1;
        }
        Date expectedStartDate = Date.newInstance(fyYear, 7, 1);

        // Re-query updated records
        List<Funds_Tracker__c> allRecs = [
            SELECT Id, Approved_Date__c, Status__c
            FROM Funds_Tracker__c
        ];

        Integer updatedCount = 0;
        Integer notUpdatedCount = 0;

        for (Funds_Tracker__c ft : allRecs) {
            if (ft.Approved_Date__c == expectedStartDate) {
                updatedCount++;
            } else {
                notUpdatedCount++;
            }
        }

      
    }
