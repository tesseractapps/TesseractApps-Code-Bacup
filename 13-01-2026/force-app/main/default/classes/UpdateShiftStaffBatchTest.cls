     @isTest
    static void testBatchExecution() {
        Test.startTest();
        // Run batch with size 200 to ensure only one execute() call
        Database.executeBatch(new UpdateShiftStaffBatch(), 200);
        Test.stopTest();

        // Verify ShiftwithStaff records updated
        List<ShiftwithStaff__c> staffList = [SELECT Shift_Name__c, Shift_Break__c FROM ShiftwithStaff__c];
        System.assertEquals(3, staffList.size(), 'There should be 3 ShiftwithStaff__c records updated.');
