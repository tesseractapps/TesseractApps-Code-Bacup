<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_number_validation_rule</fullName>
    <active>false</active>
    <description>Phone number validation rule</description>
    <errorConditionFormula>AND(OR(ISBLANK( Emergency_Phone_Number__c),REGEX( Emergency_Phone_Number__c,&quot;^[a-z A-Z]*$&quot;)))</errorConditionFormula>
    <errorDisplayField>Emergency_Phone_Number__c</errorDisplayField>
    <errorMessage>Phone number should take only numeric values</errorMessage>
</ValidationRule>
