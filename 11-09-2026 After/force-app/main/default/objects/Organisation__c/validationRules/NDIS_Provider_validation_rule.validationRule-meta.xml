<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NDIS_Provider_validation_rule</fullName>
    <active>false</active>
    <description>NDIS Provider value is 11 numbers not charcters</description>
    <errorConditionFormula>AND(OR(ISBLANK(NDIS_Provider__c),NOT(REGEX( NDIS_Provider__c,&quot;[0-9]*&quot;)),LEN( NDIS_Provider__c) != 11 ))</errorConditionFormula>
    <errorMessage>NDIS Provider value is 11 numbers not charcters</errorMessage>
</ValidationRule>
