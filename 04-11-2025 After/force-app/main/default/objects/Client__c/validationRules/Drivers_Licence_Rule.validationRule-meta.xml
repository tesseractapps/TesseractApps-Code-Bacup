<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Drivers_Licence_Rule</fullName>
    <active>false</active>
    <errorConditionFormula>OR(LEN (Drivers_Licence__c) = 0,NOT(REGEX( Drivers_Licence__c ,&quot;[0-9]*&quot;)))</errorConditionFormula>
    <errorDisplayField>Drivers_Licence__c</errorDisplayField>
    <errorMessage>Driver License should be a numeric number and should not be empty.</errorMessage>
</ValidationRule>
