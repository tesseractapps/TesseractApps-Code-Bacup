<apex:page controller="ShiftReportsDownloadController" renderAs="pdf" showHeader="false" sidebar="false" applyHtmlTag="false">
    <html>
        <head>
            <style>
                body {
                font-family: 'Roboto', sans-serif;
                background: #f9f9f9;
                color: #333;
                padding: 20px;
                }
                h1 {
                    color: #2c3e50;
                    border-bottom: 2px solid #3498db;
                    padding-bottom: 5px;
                  
                }

                h2 {
                color: #2980b9;
                background-color: #ecf0f1;
                padding: 8px;
                border-left: 5px solid #3498db;
                margin-top: 25px;
                }
                p, li {
                font-size: 14px;
                margin: 5px 0;
                }
                .section {
                background: #ffffff;
                border: 1px solid #ddd;
                border-radius: 6px;
                padding: 15px;
                margin-bottom: 20px;
                box-shadow: 1px 1px 6px rgba(0,0,0,0.05);
                }
                ul {
                padding-left: 20px;
                }
                .checkmark::after {
                content: '✔';
                color: green;
                margin-left: 5px;
                }
                .money {
                font-weight: bold;
                color: #27ae60;
                }
            </style>
        </head>
        <body>
            <h1> Staff Shift Report - {!staffName}</h1>
            
            <div class='section'>
                <h2> Staff &amp; Shift Summary</h2>
                <p><strong>Name:</strong> {!staffName}</p>
                <p><strong>Date:</strong> {!shiftDate}</p>
                <p><strong>Shift:</strong> {!shiftTime}</p>
                <p><strong>Role:</strong> {!role}</p>
            </div>
            
            <div class='section'>
                <h2> Activity Logs</h2>
                <apex:repeat value="{!activityLogs}" var="a">
                    <p><strong>{!a.logTime}</strong> - {!a.task}</p>
                </apex:repeat>
            </div>
            
            <div class='section'>
                <h2> Services Delivered</h2>
                <apex:repeat value="{!services}" var="s">
                    <p><strong>{!s.serviceTime}</strong> - {!s.service}: {!s.hours}</p>
                </apex:repeat>
            </div>
            
             <div class='section'>
                <h2>Reimbursements</h2>
                <ul>
                    <apex:repeat value="{!reimbursements}" var="item">
                        <li>
                            {!item.type}: {!item.amount} ({!item.comments}) - {!item.status}
                        </li>
                    </apex:repeat>
                </ul>
             </div>
            
            <div class='section'>
                <h2> Shift Notes</h2>
                <ul>
                    <apex:repeat value="{!shiftNotes}" var="note">
                        <li>{!note}</li>
                    </apex:repeat>
                </ul>
            </div>
            
            <div class='section'>
                <h2> Checklist</h2>
                <ul>
                    <apex:repeat value="{!checklist}" var="item">
                        <li class='checkmark'>{!item}</li>
                    </apex:repeat>
                </ul>
            </div>
            
            <div class='section'>
                <h2> Signature</h2>
                <apex:outputText value="{!signature}" escape="false"/>
            </div>

        </body>
    </html>
</apex:page>