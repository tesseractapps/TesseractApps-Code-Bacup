<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Day__c</fullName>
    <externalId>false</externalId>
    <formula>365/(DAY(DATE(YEAR( Payroll_Setting__r.Period_Start_Date__c ),(IF(MONTH(Payroll_Setting__r.Period_Start_Date__c)+1 &gt; 12, 1, MONTH(Payroll_Setting__r.Period_Start_Date__c)+1)),1)-1))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Day</label>
    <precision>18</precision>
    <required>false</required>
    <scale>4</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
