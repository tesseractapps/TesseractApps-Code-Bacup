    <formula>IF (ISBLANK(ShiftwithStaff__r.Log_In_Date_Time__c), &quot;&quot;, 

IF(HOUR(ShiftwithStaff__r.Log_In_Date_Time__c) &lt;= 12, TEXT(HOUR(ShiftwithStaff__r.Log_In_Date_Time__c)), TEXT(HOUR(ShiftwithStaff__r.Log_In_Date_Time__c)-12)) &amp; &quot;:&quot; &amp; 

