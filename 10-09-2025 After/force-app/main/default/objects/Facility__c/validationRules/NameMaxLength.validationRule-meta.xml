<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>NameMaxLength</fullName>
    <active>false</active>
    <errorConditionFormula>LEN( Name ) &gt; 50</errorConditionFormula>
    <errorDisplayField>Name</errorDisplayField>
    <errorMessage>The name must be 25 characters</errorMessage>
</ValidationRule>
