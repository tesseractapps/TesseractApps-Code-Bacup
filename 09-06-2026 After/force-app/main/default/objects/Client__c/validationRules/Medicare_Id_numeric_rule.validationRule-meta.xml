<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Medicare_Id_numeric_rule</fullName>
    <active>true</active>
    <description>Medicare card id should be numeric</description>
    <errorConditionFormula>NOT(REGEX(Medicare_Card_ID__c ,&quot;[0-9]*&quot;))</errorConditionFormula>
    <errorDisplayField>Medicare_Card_ID__c</errorDisplayField>
    <errorMessage>Medicare card ID should be a numeric,</errorMessage>
</ValidationRule>
