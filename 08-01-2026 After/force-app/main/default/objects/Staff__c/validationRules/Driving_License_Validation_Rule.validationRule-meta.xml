<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Driving_License_Validation_Rule</fullName>
    <active>false</active>
    <errorConditionFormula>AND(OR(ISBLANK( Drivers_Licence__c ),REGEX( Drivers_Licence__c ,&quot;^[a-z A-Z]*$&quot;)))</errorConditionFormula>
    <errorMessage>Driver licence should only accept numeric values</errorMessage>
</ValidationRule>
