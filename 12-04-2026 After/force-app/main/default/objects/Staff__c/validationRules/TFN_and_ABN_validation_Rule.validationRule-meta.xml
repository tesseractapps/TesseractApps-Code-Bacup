<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>TFN_and_ABN_validation_Rule</fullName>
    <active>false</active>
    <errorConditionFormula>AND(!ISBLANK(  TFN_number__c ), !ISBLANK( ABN_Number__c ))</errorConditionFormula>
    <errorMessage>TFN or ABN only one field is required</errorMessage>
</ValidationRule>
