<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contact_Number_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX( Contact_No__c , &quot;^[0-9]*$&quot;))</errorConditionFormula>
    <errorMessage>The contact number should not contain alphabets and special characters</errorMessage>
</ValidationRule>
