<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Postal_Code_Should_be_numeric</fullName>
    <active>false</active>
    <description>postal code should accept only numeric</description>
    <errorConditionFormula>NOT(REGEX( Location__PostalCode__s  ,&quot;[0-9](\\d{3})&quot;))</errorConditionFormula>
    <errorDisplayField>Location__PostalCode__s</errorDisplayField>
    <errorMessage>Postal code should be numeric and Postal code allows four digits only.</errorMessage>
</ValidationRule>
