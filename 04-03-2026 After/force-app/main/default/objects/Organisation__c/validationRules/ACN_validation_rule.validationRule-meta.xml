<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ACN_validation_rule</fullName>
    <active>true</active>
    <description>ACN value is 9 numbers not charcters</description>
    <errorConditionFormula>AND(OR(ISBLANK(ACN__c),NOT(REGEX( ACN__c,&quot;[0-9]*&quot;)),LEN( ACN__c) != 9 ))</errorConditionFormula>
    <errorDisplayField>ACN__c</errorDisplayField>
    <errorMessage>ACN value is 9 numbers not charcters</errorMessage>
</ValidationRule>
